{
  "name": "omuso-root",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "turbo": "latest",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "android": "cd apps/mobile && bun run android",
    "android:rebuild": "cd apps/mobile && bun run android:rebuild",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
